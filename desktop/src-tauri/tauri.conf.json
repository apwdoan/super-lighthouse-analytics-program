{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLAP",
  "version": "0.1.0",
  "identifier": "ca.slap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SLAP",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Lighthouse statistics, easy to retrieve and convey",
    "resources": [
      "../worker/**/*"
    ],
    "externalBin": [
      "binaries/slap-node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
