{#- Batch index: scan a whole batch at once, then open the per-site report. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Batch summary {{ b.batch_id }}</title>
<style>{% include "report.css" %}</style>
</head>
<body>
<div class="page">

  <header class="masthead">
    <div>
      {% if b.branding.logo_data_uri %}
        <img class="logo" src="{{ b.branding.logo_data_uri }}" alt="">
      {% else %}
        <div class="brand">{{ b.branding.company_name | default('Batch audit summary') }}</div>
      {% endif %}
      <div class="site">{{ b.total }} site{{ '' if b.total == 1 else 's' }} audited</div>
    </div>
    <div class="meta">
      {{ b.generated_at }}<br>
      Batch {{ b.batch_id }}
    </div>
  </header>

  <section>
    <div class="lab-strip" style="border-top:none; padding-top:0;">
      <div class="lab-stat">
        <div class="lab-label">Audited</div>
        <div class="lab-value">{{ b.completed }}</div>
        <div class="lab-note">{{ b.failed }} could not be reached</div>
      </div>
      <div class="lab-stat">
        <div class="lab-label">Failing Core Web Vitals</div>
        <div class="lab-value">{{ b.sites_failing_cwv }}</div>
        <div class="lab-note">Measured against real visitors</div>
      </div>
      <div class="lab-stat">
        <div class="lab-label">No field data</div>
        <div class="lab-value">{{ b.sites_without_field_data }}</div>
        <div class="lab-note">Too little traffic for Google to report</div>
      </div>
      <div class="lab-stat">
        <div class="lab-label">Critical and high findings</div>
        <div class="lab-value">{{ b.severity_counts.critical + b.severity_counts.high }}</div>
        <div class="lab-note">Across every site in this batch</div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div>
        <div class="eyebrow">Ranked by severity</div>
        <h2>Sites</h2>
      </div>
      <div class="caption">Worst first. Each row has its own full report.</div>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width:30%;">Site</th>
          <th style="width:15%;">Most severe</th>
          <th style="width:15%;">Core Web Vitals</th>
          <th class="num" style="width:10%;">LCP</th>
          <th class="num" style="width:12%;">Response</th>
          <th class="num" style="width:11%;">Findings</th>
          <th class="num" style="width:7%;">Ref</th>
        </tr>
      </thead>
      <tbody>
      {% for r in b.rows %}
      <tr>
        <td>
          {{ r.hostname }}
          {% if r.status != 'completed' %}
          <span class="caption">({{ r.status }})</span>
          {% endif %}
        </td>
        <td><span class="status-cell"><span class="dot {{ r.worst_status }}"></span>{{ r.worst_word }}</span></td>
        <td><span class="status-cell"><span class="dot {{ r.cwv }}"></span>{{ r.cwv_word }}</span></td>
        <td class="num">{{ r.lcp_text }}</td>
        <td class="num">{{ r.ttfb_text }}</td>
        <td class="num">{{ r.findings }}</td>
        <td class="num">{{ r.run_id }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <div class="methodology">
      <h3>Reading this summary</h3>
      <ul>
        <li><strong>Most severe</strong> is the highest-severity finding on that
            site, not a score. A site with one critical finding ranks above a
            site with twenty low ones, which is usually the right order to work in.</li>
        <li><strong>Core Web Vitals</strong> is Google's pass/fail against real
            visitor data. "No data" means the site has too little traffic for
            Google to publish measurements, not that it is slow.</li>
        <li><strong>Response</strong> is time to first byte, measured directly.
            Everything else on the page waits behind it.</li>
        <li>Each site's full report explains its findings and names the specific
            fix, including the WP Rocket setting where one applies.</li>
      </ul>
      <div class="footer-note" style="border:none; margin:0; padding:0;">
        Batch {{ b.batch_id }} &middot; generated {{ b.generated_at }}
      </div>
    </div>
  </section>

</div>
</body>
</html>
