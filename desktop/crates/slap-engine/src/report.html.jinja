{#- Client report. Rendered by slap-engine::report from a stored run, in
    Lighthouse's visual language (see report.css) and in plain words: the
    reader owns the site, and may never have opened a developer tool. The
    model is built in report.rs. -#}
{%- macro gauge(g, size="", sub=none) -%}
<div class="gauge {{ g.rating }} {{ size }}">
  <svg viewBox="0 0 120 120" role="img" aria-label="{{ g.label }}: {{ g.score if g.score is not none else 'not tested' }}">
    <circle class="base" cx="60" cy="60" r="56"></circle>
    {%- if g.score is not none %}
    <circle class="arc" cx="60" cy="60" r="56" stroke-dasharray="{{ g.dash }}" transform="rotate(-90 60 60)"></circle>
    {%- endif %}
    <text class="num" x="60" y="61">{{ g.score if g.score is not none else '–' }}</text>
  </svg>
  <div class="label">{{ g.label }}</div>
  {%- if sub %}<div class="sub">{{ sub }}</div>{% endif %}
</div>
{%- endmacro -%}
{%- macro audit_rows(audits) -%}
{%- for a in audits %}
<div class="audit {{ a.rating }}">
  <span class="icon {{ a.rating }}"></span>
  <div class="body"><span class="title">{{ a.title }}</span>{% if a.saving %}<span class="display">{{ a.saving }}</span>{% endif %}</div>
</div>
{%- endfor %}
{%- endmacro -%}
{%- macro passed(c) -%}
<div class="clumps">
  {%- if c.hidden %}<span>{{ c.hidden }} more not shown</span>{% endif -%}
  {%- if c.audits %}<span>{{ c.passed }} other check{{ '' if c.passed == 1 else 's' }} passed</span>
  {%- else %}<span>All {{ c.passed }} check{{ '' if c.passed == 1 else 's' }} passed</span>{% endif -%}
</div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Site audit: {{ hostname }}</title>
<style>{% include "report.css" %}</style>
</head>
<body>
<div class="page">

  <header class="topbar">
    {% if branding.logo_data_uri %}<img class="logo" src="{{ branding.logo_data_uri }}" alt="">{% endif %}
    {% if branding.company_name %}<div class="brand">{{ branding.company_name }}</div>
    {% elif not branding.logo_data_uri %}<div class="brand">Site performance and security audit</div>{% endif %}
    <div class="url">{{ hostname }}</div>
    <div class="meta">{{ date }}</div>
  </header>

  <div class="masthead">
    <div class="site">{{ hostname }}</div>
    {% if lh.coverage %}<div class="kicker">{{ lh.coverage }}</div>{% endif %}
  </div>

  {# ============================ score gauges ============================ #}
  {% if lh.home %}
  <div class="gauges">
    {%- for g in lh.home.gauges %}
      {{ gauge(g, "", ("Typical page: " ~ g.site_median) if g.site_median is not none else none) }}
    {%- endfor %}
  </div>
  <p class="caption scale-caption">
    <span class="scorescale"><span><span class="icon fail"></span>0–49 poor</span><span><span class="icon average"></span>50–89 needs work</span><span><span class="icon pass"></span>90–100 good</span></span>
    Home page scores out of 100, tested as {{ lh.setup }}{% if lh.home.runs and lh.home.runs > 1 %} (the middle of {{ lh.home.runs }} tests){% endif %}.{% if lh.multi %} "Typical page" is the middle score of all {{ lh.measured }} pages tested.{% endif %}
  </p>
  {% endif %}

  {# ============================== verdict ============================== #}
  <section class="first">
    <div class="verdict">
      <div class="assessment">
        <span class="icon {{ 'pass' if verdict.flag_class == 'good' else ('fail' if verdict.flag_class == 'poor' else 'none') }}"></span>
        Google's Core Web Vitals for real visitors:
        <b class="{{ 'pass' if verdict.flag_class == 'good' else ('fail' if verdict.flag_class == 'poor' else '') }}">{{ verdict.flag_word }}</b>
      </div>
      <div class="headline">{{ verdict.headline }}</div>
      <p>{{ verdict.explanation }}</p>
      {% for n in verdict.news %}<p class="news"><span class="icon pass"></span>{{ n }}</p>{% endfor %}

      {% if verdict.has_field %}
      <div class="field">
        {% for t in verdict.tiles %}
        <div class="field-metric {{ t.rating }}">
          <div class="name"><span class="icon {{ t.rating }}"></span>{{ t.caption }} ({{ t.label }})</div>
          <div class="value">{{ t.value }}</div>
          <div class="scale-wrap">
            <div class="marker" style="left: {{ t.meter_pct }}%;"></div>
            <div class="scale"><span class="g"></span><span class="n"></span><span class="p"></span></div>
          </div>
          <div class="note">{{ t.status_word }} &middot; {{ t.threshold }}{% if t.good_share %} &middot; {{ t.good_share }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      <p class="caption" style="margin:6px 0 0;">From Google's record of real visits to the whole site over the last 28 days. Each figure is what 3 out of 4 visits matched or beat.</p>
      {% endif %}
    </div>
  </section>

  {# ============================ what to fix ============================ #}
  <section>
    <div class="section-head">
      <h2>What to fix first</h2>
      <div class="caption">
        {{ total_findings }} issue{{ '' if total_findings == 1 else 's' }}
        {%- for k in ['critical', 'high', 'medium', 'low'] %}{% if severity_counts[k] %} &middot; {{ severity_counts[k] }} {{ k }}{% endif %}{% endfor %}
      </div>
    </div>

    {% if not significant and not minor %}
    <p class="secondary">No problems were found that need fixing.</p>
    {% elif is_multipage %}
    <p class="secondary" style="margin-top:0;">Most important first. Each issue is listed once, with the pages it affects.</p>
    {% endif %}

    {% for f in significant %}
    <article class="finding {{ f.status }}">
      <div class="sev-bar"></div>
      <div class="finding-main">
        <div class="finding-head">
          <h3>{{ f.title }}</h3>
          <span class="badge"><span class="dot {{ f.status }}"></span>{{ f.severity_word }}</span>
        </div>
        <p class="detail">{{ f.detail }}</p>

        {% if f.scope_text or f.effort_label %}
        <div class="scope">
          {%- if f.scope_text %}<span class="scope-label">Affects</span><strong>{{ f.scope_text }}</strong>
          {%- if not f.is_sitewide and f.page_count > 1 %}<span class="scope-pages">: {{ f.pages | join(", ") }}{% if f.page_count > 8 %}, <span class="secondary">and {{ f.page_count - 8 }} more</span>{% endif %}</span>{% endif %}{% endif %}
          {%- if f.effort_label %}<span class="meta">{{ f.effort_label }}</span>{% endif %}
        </div>
        {% endif %}

        {% if (f.remediation and show_fix_advice) or (f.wp_rocket_setting and show_wp_rocket) %}
        <div class="fix">
          {% if f.remediation and show_fix_advice %}<span class="fix-label">How to fix</span>{{ f.remediation }}{% endif %}
          {% if f.wp_rocket_setting and show_wp_rocket %}<div class="wp-rocket"><span class="fix-label">In WP Rocket</span>{{ f.wp_rocket_setting }}</div>{% endif %}
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}

    {% if minor %}
    <h3 class="minor-head">Smaller improvements</h3>
    {% for f in minor %}
    <div class="finding-compact">
      <span class="badge"><span class="dot {{ f.status }}"></span>{{ f.severity_word }}</span>
      <span class="title">{{ f.title }}</span>
      {% if f.scope_text %}<span class="secondary">{{ f.scope_text }}</span>{% endif %}
    </div>
    {% endfor %}
    {% endif %}
  </section>

  {# ======================== the home page in detail ======================== #}
  {% if lh.home %}
  <section>
    <div class="section-head"><h2>Home page in detail</h2></div>

    {% set perf = lh.home.categories[0] if lh.home.categories and lh.home.categories[0].id == 'performance' else none %}
    <div class="lh-category">
      <div class="perf-top">
        <div class="lh-category-head">
          {{ gauge(lh.home.gauges[0], "big") }}
          <div class="description">How quickly the page loads and becomes usable. The figures are estimates and vary a little between tests.</div>
        </div>
        <div>
          <div class="metrics-head"><span>Speed measurements</span>{% if lh.home.perf_spread %}<span class="muted plain">Score varied by {{ lh.home.perf_spread | int }} point{{ '' if lh.home.perf_spread | int == 1 else 's' }} between tests</span>{% endif %}</div>
          <div class="metrics">
            {% for m in lh.home.metrics %}
            <div class="metric {{ m.rating }}">
              <div class="title"><span class="icon {{ m.rating }}"></span>{{ m.name }}<span class="abbr">{{ m.abbr }}</span></div>
              <div class="value">{{ m.display }}{% if m.spread %}<span class="spread">{{ m.spread }} between tests</span>{% endif %}</div>
              <div class="hint">{{ m.hint }}</div>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% if perf %}
        {% if perf.audits %}
        <div class="audit-group">
          <div class="audit-group-head">Ways to make it faster <span class="count">({{ perf.audits | length }})</span></div>
          {{ audit_rows(perf.audits) }}
        </div>
        {% endif %}
        {{ passed(perf) }}
      {% elif not lh.home.has_summary %}
      <p class="caption" style="margin-top:4px;">The detailed results for this page were not kept, so only its scores are shown.</p>
      {% endif %}
    </div>

    <div class="cat-grid">
    {% for c in lh.home.categories %}{% if c.id != 'performance' %}
      <div class="lh-category">
        <div class="lh-category-head inline">
          {{ gauge(c.gauge, "small") }}
          <div class="title">{{ c.label }}</div>
        </div>
        <div class="cat-blurb">{{ c.blurb }}</div>
        {{ audit_rows(c.audits) }}
        {{ passed(c) }}
      </div>
    {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# =========================== across the site =========================== #}
  {% if is_multipage %}
  <section>
    <div class="section-head">
      <h2>Across the site</h2>
      <div class="caption">{% if lh.measured %}{{ lh.measured }} of {{ pages | length }} pages tested{% else %}{{ pages | length }} pages{% endif %}</div>
    </div>
    {% if lh.coverage %}<p class="coverage">{{ lh.coverage }}{% if lh.limit_note %} {{ lh.limit_note }}{% endif %}</p>{% endif %}

    {% if lh.multi %}
    <div class="dist-head"><span>Score</span><span class="r">Typical</span><span>How the pages scored</span><span class="r">Pages</span></div>
    {% for d in lh.distribution %}
    <div class="dist">
      <div class="name">{{ d.label }}</div>
      <div class="median {{ d.rating }}">{{ d.median }}</div>
      <div class="stack">
        {% if d.fail %}<span class="fail" style="width: {{ d.fail_pct }}%"></span>{% endif %}
        {% if d.average %}<span class="average" style="width: {{ d.average_pct }}%"></span>{% endif %}
        {% if d.pass %}<span class="pass" style="width: {{ d.pass_pct }}%"></span>{% endif %}
      </div>
      <div class="counts">
        <span><span class="icon fail"></span>{{ d.fail }}</span>
        <span><span class="icon average"></span>{{ d.average }}</span>
        <span><span class="icon pass"></span>{{ d.pass }}</span>
      </div>
    </div>
    {% endfor %}

    {% if lh.common %}
    <div class="audit-group common">
      <div class="audit-group-head">Most common problems <span class="count">(by pages affected, of {{ lh.summarised }})</span></div>
      {% for a in lh.common %}
      <div class="audit {{ a.rating }}">
        <span class="icon {{ a.rating }}"></span>
        <div class="body">
          <span class="title">{{ a.title }}</span><span class="aside">{{ a.category }}{% if a.saving %} &middot; {{ a.saving }}{% endif %}</span>
        </div>
        <div class="spread-pages"><b>{{ a.pages }}</b> of {{ a.of }} pages</div>
      </div>
      {% endfor %}
      {% if lh.common_more %}<div class="clumps"><span>{{ lh.common_more }} less common problem{{ '' if lh.common_more == 1 else 's' }} not shown</span></div>{% endif %}
    </div>
    {% endif %}
    {% endif %}

    {% set scored = lh.attempted %}
    <h3 class="minor-head">Every page</h3>
    <table class="inventory">
      <thead><tr>
        <th>Page</th><th>Type</th>
        {% if scored %}
        <th class="num">Performance</th><th class="num">Accessibility</th>
        <th class="num">Best Practices</th><th class="num">SEO</th>
        <th class="num">Main content</th>
        {% endif %}
        <th class="num">Issues</th>
      </tr></thead>
      <tbody>
        {% for p in pages %}
        <tr>
          <td class="path">{{ p.path }}</td>
          <td class="kind">{{ p.kind }}</td>
          {% if not scored %}
          {% elif p.measured %}
            {% for sc in p.scores %}
            <td class="num"><span class="score {{ sc.rating }}"><span class="icon {{ sc.rating }}"></span>{{ sc.text if sc.text is not none else '–' }}</span></td>
            {% endfor %}
            <td class="num">{% if p.lcp %}<span class="score {{ p.lcp.rating }}">{{ p.lcp.text }}</span>{% else %}–{% endif %}</td>
          {% elif p.lh_failed %}
            <td class="num" colspan="5"><span class="secondary">Could not be tested</span></td>
          {% else %}
            <td class="num" colspan="5"><span class="secondary">Not tested</span></td>
          {% endif %}
          <td class="num">{{ p.issues }}{% if p.urgent %} <span class="secondary">({{ p.urgent }} urgent)</span>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="caption" style="margin-top:4px;">{% if scored %}Main content is when the largest text or image appears (LCP). {% endif %}Issues counts the problems from What to fix first found on that page, apart from those that affect the whole site; urgent ones are critical or high.</p>
  </section>
  {% endif %}

  {# ======================= pages worth a closer look ======================= #}
  {% if lh.pages %}
  <section>
    <div class="section-head"><h2>Pages worth a closer look</h2>
      <div class="caption">{{ lh.pages_covered }} page{{ '' if lh.pages_covered == 1 else 's' }}</div></div>
    <p class="secondary" style="margin-top:0;">
      {%- if lh.every_page %}These pages score well below the rest of the site, or have problems most other pages do not. Pages of the same type with the same problems are shown once.
      {%- else %}One page of each type was tested, and each speaks for the pages like it. Here are their scores and what is holding them back.{% endif %}
      {%- if lh.more_pages %} {{ lh.more_pages }} more page{{ '' if lh.more_pages == 1 else 's' }} also stood out but {{ 'is' if lh.more_pages == 1 else 'are' }} not shown.{% endif %}</p>

    {% for pg in lh.pages %}
    <div class="page-detail">
      <div class="page-detail-head"><span class="path">{{ pg.path }}</span><span class="chip">{{ pg.kind }}</span>{% for r in pg.reasons %}<span class="chip">{{ r }}</span>{% endfor %}</div>
      {% if pg.own %}<div class="own">Problems most other pages do not have: {{ pg.own | join("; ") }}.</div>{% endif %}
      {% if pg.alike_count %}<div class="alike">The same problems on {{ pg.alike_count }} other page{{ '' if pg.alike_count == 1 else 's' }}: <span class="paths">{{ pg.alike | join(", ") }}</span>{% if pg.alike_more %}, and {{ pg.alike_more }} more{% endif %}</div>{% endif %}
      <div class="keep page-top">
        <div class="gauges">{% for g in pg.gauges %}{{ gauge(g, "small") }}{% endfor %}</div>
        <div class="metrics">
          {% for m in pg.metrics %}
          <div class="metric {{ m.rating }}">
            <div class="title"><span class="icon {{ m.rating }}"></span>{{ m.name }}</div>
            <div class="value">{{ m.display }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {# Two columns of problems: the categories flow across both. #}
      <div class="cats">
      {% for c in pg.categories %}
        {% if c.audits %}
        <div class="audit-group">
          <div class="audit-group-head">{{ c.label }} <span class="count">&middot; {{ c.gauge.score }}</span></div>
          {{ audit_rows(c.audits) }}
          {% if c.hidden %}<div class="clumps"><span>and {{ c.hidden }} more</span></div>{% endif %}
        </div>
        {% endif %}
      {% endfor %}
      </div>
      {% if not pg.has_summary %}<p class="caption" style="margin-top:4px;">The detailed results for this page were not kept, so only its scores are shown.</p>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {# ============================= security ============================= #}
  <section>
    <div class="section-head"><h2>Security</h2>
      {% if security.checked_headers %}<div class="caption">{{ security.headers_set }} of {{ security.headers_total }} recommended protections in place</div>{% endif %}</div>

    <div class="sec-grid">
      <div>
        {% if security.connection %}
        <div class="sec-group">
          <h3>Secure connection</h3>
          <table><tbody>
            {% for r in security.connection %}
            <tr><td style="width:46%;">{{ r.label }}</td>
              <td>{% if r.rating %}<span class="status-cell"><span class="icon {{ r.rating }}"></span>{{ r.value }}</span>{% else %}{{ r.value }}{% endif %}</td></tr>
            {% endfor %}
          </tbody></table>
        </div>
        {% endif %}

        {% if security.cookies_total is not none %}
        <div class="sec-group">
          <h3>Cookies</h3>
          {% if security.cookies %}
          <table><tbody>
            {% for r in security.cookies %}
            <tr><td style="width:78%;">{{ r.label }}</td><td class="num">{{ r.value }}</td></tr>
            {% endfor %}
          </tbody></table>
          {% else %}
          <p class="secondary">The home page sets no cookies.</p>
          {% endif %}
        </div>
        {% endif %}
      </div>

      {% if security.checked_headers %}
      <div class="sec-group">
        <h3>Protective settings (security headers)</h3>
        <table><tbody>
          {% for h in security.headers %}
          <tr><td>{{ h.label }}<div class="tech">{{ h.name }}</div></td>
            <td style="width:24%;"><span class="status-cell"><span class="icon {{ 'pass' if h.set else 'average' }}"></span>{{ 'Set' if h.set else 'Missing' }}</span></td></tr>
          {% endfor %}
        </tbody></table>
      </div>
      {% endif %}
    </div>
    {% if security.checked_headers or security.cookies_total is not none %}
    <p class="caption" style="margin:0;">Security settings and cookies were checked on the home page.</p>
    {% endif %}
  </section>

  {# ======================= software and technology ======================= #}
  {% if software or tech.cms or tech.cdn or tech.server or tech.page_builder or tech.cache_plugin or tech.wp_rocket %}
  <section>
    <div class="section-head"><h2>Software and technology</h2>
      {% if software %}<div class="caption">{{ software.count }} component{{ '' if software.count == 1 else 's' }} found</div>{% endif %}</div>
    <div class="techlist">
      {% if tech.cms %}<span class="chip">Platform <strong>{{ tech.cms }}</strong></span>{% endif %}
      {% if tech.page_builder %}<span class="chip">Page builder <strong>{{ tech.page_builder }}</strong></span>{% endif %}
      {% if tech.cdn %}<span class="chip">Content delivery network <strong>{{ tech.cdn }}</strong></span>{% endif %}
      {% if tech.server %}<span class="chip">Web server <strong>{{ tech.server }}</strong></span>{% endif %}
      {% if tech.cache_plugin %}<span class="chip">Caching <strong>{{ tech.cache_plugin }}</strong></span>{% endif %}
      {% if tech.wp_rocket %}<span class="chip">WP Rocket <strong>{{ tech.wp_rocket }}</strong></span>{% endif %}
    </div>
    {% if software %}
    {% if software.detected %}<p>Found on the site: {{ software.detected }}.</p>{% endif %}
    <p>{{ software.flaws }}</p>
    {% if software.db_note %}<p class="caption">{{ software.db_note }}</p>{% endif %}
    {% endif %}
  </section>
  {% endif %}

  {# ========================== about this report ========================== #}
  <section class="appendix">
    <div class="section-head"><h2>About this report</h2></div>

    <div class="methodology">
      <h3>How we tested</h3>
      <ul>
        {% if about.lighthouse == 'tested' %}
        <li>Each page tested was loaded {% if about.runs == 1 %}once {% elif about.runs %}{{ about.runs }} times {% endif %}with Google Lighthouse, the testing tool behind Google's PageSpeed Insights, set up to behave like {{ about.device }} on {{ about.network }}.{% if about.runs and about.runs > 1 %} Scores use the middle result, so one unusually fast or slow test does not skew them.{% endif %} On a modern computer with fast broadband, pages will usually feel quicker than these figures suggest.</li>
        {% elif about.lighthouse == 'failed' %}
        <li>Browser tests with Google Lighthouse were tried but could not be completed, so this report covers the server, security and delivery checks only.</li>
        {% else %}
        <li>This audit did not include browser tests, so it covers the server, security and delivery checks only.</li>
        {% endif %}
        {% if verdict.has_field %}<li>Real-visitor figures come from Google's Chrome User Experience Report: real visits to the whole site over the last 28 days.</li>{% endif %}
        <li>We also checked the site directly: its security certificate, security settings, redirects, and how its pages are delivered.</li>
        {% if lh.coverage %}<li>{{ lh.coverage }}{% if lh.limit_note %} {{ lh.limit_note }}{% endif %}</li>{% endif %}
        <li>Each audit is kept as a separate record, so a later audit can be compared exactly with this one.</li>
      </ul>
      <h3>Test details</h3>
      <div class="runtime">
        {% for d in about.details %}<div><span>{{ d.label }}</span><span>{{ d.value }}</span></div>{% endfor %}
      </div>
      {% if about.notes %}
      <h3>Notes on these results</h3>
      <ul>
        {% for n in about.notes %}<li><b>{{ n.title }}{% if n.scope %} ({{ n.scope }}){% endif %}.</b> {{ n.detail }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>

    {% if about.other %}
    <h3 class="appendix-head">Other measurements</h3>
    <div class="measurements">
      {% for r in about.other %}
      <div class="m-row"><div class="m-label">{{ r.label }}</div><div class="m-value">{{ r.value }}</div></div>
      {% endfor %}
    </div>
    <p class="caption" style="margin-top:4px;">The full technical record of this audit, with every measurement taken, is available on request.</p>
    {% endif %}

    <div class="footer-note">Produced with SLAP {{ provenance.slap_version }} on {{ date }}. Audit reference {{ run_id }}.</div>
  </section>

</div>
</body>
</html>
