{#- Client report. Rendered by slap-engine::report from a stored run, in
    Lighthouse's visual language (see report.css). The model is built in
    report.rs. -#}
{%- macro gauge(g, size="", sub=none) -%}
<div class="gauge {{ g.rating }} {{ size }}">
  <svg viewBox="0 0 120 120" role="img" aria-label="{{ g.label }}: {{ g.score if g.score is not none else 'not measured' }}">
    <circle class="base" cx="60" cy="60" r="56"></circle>
    {%- if g.score is not none %}
    <circle class="arc" cx="60" cy="60" r="56" stroke-dasharray="{{ g.dash }}" transform="rotate(-90 60 60)"></circle>
    {%- endif %}
    <text class="num" x="60" y="61">{{ g.score if g.score is not none else '–' }}</text>
  </svg>
  <div class="label">{{ g.label }}</div>
  {%- if sub %}<div class="sub">{{ sub }}</div>{% endif %}
</div>
{%- endmacro -%}
{%- macro audit_rows(groups, show_description=true) -%}
{%- for grp in groups %}
<div class="audit-group">
  <div class="audit-group-head">{{ grp.title }} <span class="count">({{ grp.audits | length }})</span></div>
  {%- for a in grp.audits %}
  <div class="audit {{ a.rating }}">
    <span class="icon {{ a.rating }}"></span>
    <div class="body">
      <span class="title">{{ a.title }}</span>{% if a.display %}<span class="display">{{ a.display }}</span>{% endif %}
      {%- if show_description and a.description %}<div class="description">{{ a.description }}</div>{% endif %}
    </div>
  </div>
  {%- endfor %}
</div>
{%- endfor %}
{%- endmacro -%}
{%- macro clumps(c) -%}
<div class="clumps">
  {%- if c.hidden %}<span>{{ c.hidden }} more not shown</span>{% endif -%}
  <span>Passed audits ({{ c.passed }})</span>
  {%- if c.manual %}<span>Additional items to manually check ({{ c.manual }})</span>{% endif -%}
  {%- if c.not_applicable %}<span>Not applicable ({{ c.not_applicable }})</span>{% endif -%}
</div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Site audit: {{ hostname }}</title>
<style>{% include "report.css" %}</style>
</head>
<body>
<div class="page">

  <header class="topbar">
    {% if branding.logo_data_uri %}<img class="logo" src="{{ branding.logo_data_uri }}" alt="">{% endif %}
    {% if branding.company_name %}<div class="brand">{{ branding.company_name }}</div>
    {% elif not branding.logo_data_uri %}<div class="brand">Site performance and security audit</div>{% endif %}
    <div class="url">{{ hostname }}</div>
    <div class="meta">{{ generated_at }} &middot; Audit reference {{ run_id }}</div>
  </header>

  <div class="masthead">
    <div class="site">{{ hostname }}</div>
    {% if lh and lh.coverage %}<div class="kicker">{{ lh.coverage }}</div>{% endif %}
  </div>

  {# ============================ score gauges ============================ #}
  {% if lh and lh.home %}
  <div class="gauges">
    {%- for g in lh.home.gauges %}
      {{ gauge(g, "", ("Site median " ~ g.site_median) if g.site_median is not none else none) }}
    {%- endfor %}
  </div>
  <div class="scorescale">
    <span><span class="icon fail"></span>0–49</span>
    <span><span class="icon average"></span>50–89</span>
    <span><span class="icon pass"></span>90–100</span>
  </div>
  <p class="caption" style="text-align:center;margin-top:4px;">
    Lighthouse scores for the home page{% if lh.home.runs %}, the median of {{ lh.home.runs }} runs{% endif %}{% if lh.runtime %} ({{ lh.runtime.device }}, {{ lh.runtime.network | replace(' (simulated)', '') }}){% endif %}.{% if lh.multi %} Site medians cover all {{ lh.measured }} measured pages.{% endif %}
  </p>
  {% endif %}

  {# ============================== verdict ============================== #}
  <section style="margin-top:14px;">
    <div class="verdict">
      <div class="assessment">
        <span class="icon {{ 'pass' if verdict.flag_class == 'good' else ('fail' if verdict.flag_class == 'poor' else 'none') }}"></span>
        Core Web Vitals assessment:
        <b class="{{ 'pass' if verdict.flag_class == 'good' else ('fail' if verdict.flag_class == 'poor' else '') }}">{{ verdict.flag_word }}</b>
      </div>
      <div class="headline">{{ verdict.headline }}</div>
      <p>{{ verdict.explanation }}</p>

      {% if verdict.has_field %}
      <div class="field">
        {% for t in verdict.tiles %}
        <div class="field-metric {{ t.rating }}">
          <div class="name"><span class="icon {{ t.rating }}"></span>{{ t.caption }} ({{ t.label }})</div>
          <div class="value">{{ t.value }}</div>
          <div class="scale-wrap">
            <div class="marker" style="left: {{ t.meter_pct }}%;"></div>
            <div class="scale"><span class="g"></span><span class="n"></span><span class="p"></span></div>
          </div>
          <div class="note">{{ t.status_word }} &middot; {{ t.threshold }}{% if t.good_share %} &middot; {{ t.good_share }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      <p class="caption" style="margin-top:10px;">Field data from Google's Chrome UX Report: the 75th percentile of real visits over the last 28 days, for the whole origin.</p>
      {% endif %}
    </div>
  </section>

  {# ============================ what to fix ============================ #}
  <section>
    <div class="section-head">
      <div><div class="eyebrow">Section 1</div><h2>What to fix first</h2></div>
      <div class="caption">
        {{ total_findings }} issue{{ '' if total_findings == 1 else 's' }} &middot;
        {{ severity_counts.critical }} critical &middot;
        {{ severity_counts.high }} high &middot;
        {{ severity_counts.medium }} medium
      </div>
    </div>

    {% if is_multipage %}
    <p class="secondary" style="margin-top:0;">Each issue is listed once, with the pages it affects. An issue on every page is one thing to fix, not many.</p>
    {% endif %}

    {% if not significant and not minor %}
    <p class="secondary">Nothing significant was found. Every measurement taken is listed in the appendix.</p>
    {% endif %}

    {% for f in significant %}
    <article class="finding {{ f.status }}">
      <div class="sev-bar"></div>
      <div class="finding-main">
        <div class="finding-head">
          <h3>{{ f.title }}</h3>
          <span class="badge"><span class="dot {{ f.status }}"></span>{{ f.severity_word }}</span>
        </div>
        <p class="detail">{{ f.detail }}</p>

        {% if f.scope_text %}
        <div class="scope">
          <span class="scope-label">Affects</span><strong>{{ f.scope_text }}</strong>
          {% if not f.is_sitewide and f.page_count > 1 %}
          <ul class="scope-pages">
            {% for p in f.pages %}<li>{{ p }}</li>{% endfor %}
            {% if f.page_count > 8 %}<li class="secondary">and {{ f.page_count - 8 }} more</li>{% endif %}
          </ul>
          {% endif %}
        </div>
        {% endif %}

        {% if f.remediation or (f.wp_rocket_setting and show_wp_rocket) %}
        <div class="fix">
          {% if f.remediation %}<span class="fix-label">Fix</span>{{ f.remediation }}{% endif %}
          {% if f.wp_rocket_setting and show_wp_rocket %}<div class="wp-rocket"><span class="fix-label">In WP Rocket</span>{{ f.wp_rocket_setting }}</div>{% endif %}
        </div>
        {% endif %}

        {% if f.effort_label or f.impact_text %}
        <div class="finding-meta">
          {% if f.effort_label %}<span>{{ f.effort_label }}</span>{% endif %}
          {% if f.impact_text %}<span>Measured at {{ f.impact_text }}</span>{% endif %}
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}

    {% if minor %}
    <h3 style="margin-top:18px; margin-bottom:4px;">Also worth addressing</h3>
    {% for f in minor %}
    <div class="finding-compact">
      <span class="badge"><span class="dot {{ f.status }}"></span>{{ f.severity_word }}</span>
      <span class="title">{{ f.title }}</span>
      {% if f.scope_text %}<span class="secondary">{{ f.scope_text }}</span>{% endif %}
    </div>
    {% endfor %}
    {% endif %}
  </section>

  {# ====================== Lighthouse: the home page ====================== #}
  {% if lh and lh.home %}
  <section class="page-break">
    <div class="section-head">
      <div><div class="eyebrow">Section 2</div><h2>Lighthouse: the home page</h2></div>
      <div class="caption">{{ lh.home.path }}</div>
    </div>

    {% set perf = lh.home.categories[0] if lh.home.categories and lh.home.categories[0].id == 'performance' else none %}
    <div class="lh-category">
      <div class="lh-category-head">
        {{ gauge(lh.home.gauges[0], "big") }}
        <div class="description">Values are estimated and may vary. The performance score is calculated directly from these metrics{% if lh.home.runs %}, each the median of {{ lh.home.runs }} runs{% endif %}.</div>
      </div>
      <div class="metrics-head"><span>Metrics</span>{% if lh.home.perf_spread %}<span class="muted" style="text-transform:none;letter-spacing:0;">Score moved {{ lh.home.perf_spread | int }} point{{ '' if lh.home.perf_spread | int == 1 else 's' }} across runs</span>{% endif %}</div>
      <div class="metrics">
        {% for m in lh.home.metrics %}
        <div class="metric {{ m.rating }}">
          <div class="title"><span class="icon {{ m.rating }}"></span>{{ m.title }}</div>
          <div class="value">{{ m.display }}{% if m.spread %}<span class="spread">{{ m.spread }} across runs</span>{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      {% if perf %}
        {{ audit_rows(perf.groups) }}
        {{ clumps(perf) }}
      {% elif not lh.home.has_summary %}
      <p class="caption" style="margin-top:8px;">The audit list for this page was not kept, so only its scores and metrics are shown.</p>
      {% endif %}
    </div>

    {% for c in lh.home.categories %}{% if c.id != 'performance' %}
    <div class="lh-category">
      <div class="lh-category-head inline">
        {{ gauge(c.gauge, "small") }}
        <div class="title">{{ c.label }}</div>
      </div>
      {% if c.groups %}{{ audit_rows(c.groups) }}{% else %}<p class="secondary" style="margin:6px 0 0;">Every automated {{ c.label | lower }} check passed.</p>{% endif %}
      {{ clumps(c) }}
    </div>
    {% endif %}{% endfor %}
  </section>
  {% endif %}

  {# ========================= across every page ========================= #}
  {% if lh and lh.multi %}
  <section class="page-break">
    <div class="section-head">
      <div><div class="eyebrow">Section 3</div><h2>Lighthouse across {{ lh.measured }} pages</h2></div>
      <div class="caption">{{ lh.scope_label or '' }}</div>
    </div>
    <p class="coverage">{{ lh.coverage }}{% if lh.cap_note %} {{ lh.cap_note }}{% endif %}</p>

    <div class="dist-head"><span>Category</span><span class="r">Median</span><span>Pages by score</span><span class="r">Pages</span></div>
    {% for d in lh.distribution %}
    <div class="dist">
      <div class="name">{{ d.label }}</div>
      <div class="median {{ d.rating }}">{{ d.median }}</div>
      <div class="stack">
        {% if d.fail %}<span class="fail" style="width: {{ d.fail_pct }}%"></span>{% endif %}
        {% if d.average %}<span class="average" style="width: {{ d.average_pct }}%"></span>{% endif %}
        {% if d.pass %}<span class="pass" style="width: {{ d.pass_pct }}%"></span>{% endif %}
      </div>
      <div class="counts">
        <span><span class="icon fail"></span>{{ d.fail }}</span>
        <span><span class="icon average"></span>{{ d.average }}</span>
        <span><span class="icon pass"></span>{{ d.pass }}</span>
      </div>
    </div>
    {% endfor %}

    {% if lh.common %}
    <div class="audit-group" style="margin-top:22px;">
      <div class="audit-group-head">Most common Lighthouse issues <span class="count">(by pages affected, of {{ lh.summarised }})</span></div>
      {% for a in lh.common %}
      <div class="audit {{ a.rating }}">
        <span class="icon {{ a.rating }}"></span>
        <div class="body">
          <span class="title">{{ a.title }}</span>
          <div class="description">{{ a.category }}{% if a.saving %} &middot; typical saving {{ a.saving }}{% endif %}</div>
        </div>
        <div class="spread-pages"><b>{{ a.pages }}</b> of {{ a.of }} pages</div>
      </div>
      {% endfor %}
      {% if lh.common_more %}<div class="clumps"><span>{{ lh.common_more }} less common issues not shown; each page's own list is in its section below.</span></div>{% endif %}
    </div>
    {% endif %}
    {% if lh.drift %}
    <p class="caption" style="margin-top:12px;">The measuring machine's CPU benchmark ranged {{ lh.benchmark_range }} across this run ({{ lh.drift }} drift). Pages measured hours apart are compared most safely by their issues, not by small score differences.</p>
    {% endif %}
  </section>
  {% endif %}

  {# ========================== page inventory ========================== #}
  {% if is_multipage %}
  <section class="page-break">
    <div class="section-head"><div><div class="eyebrow">Section 4</div><h2>Pages audited</h2></div>
      <div class="caption">{{ pages | length }} pages</div></div>
    <table class="inventory">
      <thead><tr>
        <th>Page</th><th>Template</th>
        <th class="num" title="Performance">Perf</th><th class="num" title="Accessibility">A11y</th>
        <th class="num" title="Best Practices">BP</th><th class="num">SEO</th>
        <th class="num">LCP</th><th class="num">TBT</th><th class="num">CLS</th>
        <th class="num">Issues</th>
      </tr></thead>
      <tbody>
        {% for p in pages %}
        <tr>
          <td class="path">{{ p.path }}</td>
          <td>{{ p.template }}</td>
          {% if p.measured %}
            {% for sc in p.scores %}
            <td class="num"><span class="score {{ sc.rating }}"><span class="icon {{ sc.rating }}"></span>{{ sc.text if sc.text is not none else '–' }}</span></td>
            {% endfor %}
            {% for m in [p.lcp, p.tbt, p.cls] %}
            <td class="num">{% if m %}<span class="score {{ m.rating }}">{{ m.text }}</span>{% else %}–{% endif %}</td>
            {% endfor %}
          {% elif p.lh_failed %}
            <td class="num" colspan="7"><span class="secondary">Lighthouse could not measure this page</span></td>
          {% else %}
            <td class="num" colspan="7"><span class="secondary">Not measured</span></td>
          {% endif %}
          <td class="num">{{ p.findings }}{% if p.urgent %} <span class="secondary">({{ p.urgent }} urgent)</span>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# ===================== Lighthouse, page by page ===================== #}
  {% if lh and lh.pages %}
  <section class="page-break">
    <div class="section-head"><div><div class="eyebrow">Section 5</div><h2>Pages worth a closer look</h2></div>
      <div class="caption">{{ lh.pages | length }} page{{ '' if lh.pages | length == 1 else 's' }}</div></div>
    {% if lh.pages_all %}
    <p class="secondary" style="margin-top:0;">With {{ lh.measured }} pages measured, each one besides the home page has its own section: its scores, its metrics, and its failing Lighthouse audits.</p>
    {% else %}
    <p class="secondary" style="margin-top:0;">The pages below stand out from the rest of the site, or carry issues few other pages have. Every page's scores are in the table above; each section here lists that page's failing Lighthouse audits.{% if lh.more_pages %} {{ lh.more_pages }} further page{{ '' if lh.more_pages == 1 else 's' }} also qualified and {{ 'is' if lh.more_pages == 1 else 'are' }} not shown.{% endif %}</p>
    {% endif %}

    {% for pg in lh.pages %}
    <div class="page-detail">
      <div class="page-detail-head"><span class="path">{{ pg.path }}</span><span class="chip">{{ pg.template }}</span></div>
      {% if pg.reasons %}<div class="why">{% for r in pg.reasons %}<span class="chip">{{ r }}</span>{% endfor %}</div>{% endif %}
      <div class="keep">
        <div class="gauges">{% for g in pg.gauges %}{{ gauge(g, "small") }}{% endfor %}</div>
        <div class="metrics">
          {% for m in pg.metrics %}
          <div class="metric {{ m.rating }}">
            <div class="title"><span class="icon {{ m.rating }}"></span>{{ m.title }}</div>
            <div class="value">{{ m.display }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% for c in pg.categories %}
        {% if c.groups %}
        <div class="audit-group">
          <div class="audit-group-head">{{ c.label }} <span class="count">&middot; {{ c.gauge.score }}</span></div>
          {% for grp in c.groups %}{% for a in grp.audits %}
          <div class="audit {{ a.rating }}">
            <span class="icon {{ a.rating }}"></span>
            <div class="body"><span class="title">{{ a.title }}</span>{% if a.display %}<span class="display">{{ a.display }}</span>{% endif %}</div>
          </div>
          {% endfor %}{% endfor %}
          {% if c.hidden %}<div class="clumps"><span>{{ c.hidden }} more not shown</span></div>{% endif %}
        </div>
        {% endif %}
      {% endfor %}
      {% if not pg.has_summary %}<p class="caption" style="margin-top:6px;">The audit list for this page was not kept, so only its scores and metrics are shown.</p>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {# ============================= software ============================= #}
  {% if software %}
  <section>
    <div class="section-head"><div><div class="eyebrow">Section 6</div><h2>Software detected</h2></div>
      <div class="caption">{{ software.count }} component{{ '' if software.count == 1 else 's' }}</div></div>
    {% if software.detected %}<p>{{ software.detected }}</p>{% endif %}
    <div class="techlist">
      <span class="chip">Components <strong>{{ software.count }}</strong></span>
      <span class="chip">Observed versions <strong>{{ software.observed }}</strong></span>
      <span class="chip">Inferred versions <strong>{{ software.inferred }}</strong></span>
      {% if software.confirmed is not none %}<span class="chip">Confirmed vulnerabilities <strong>{{ software.confirmed }}</strong></span>{% endif %}
      {% if software.possible is not none %}<span class="chip">Possible <strong>{{ software.possible }}</strong></span>{% endif %}
      {% if software.unchecked is not none %}<span class="chip">Not in database <strong>{{ software.unchecked }}</strong></span>{% endif %}
    </div>
    {% if software.db_generated %}
    <p class="caption">Checked against {{ software.db_sources | default('the vulnerability database') }}, generated {{ software.db_generated }}{% if software.db_age is not none %} ({{ software.db_age }} days old){% endif %}. Confirmed means a browser read the version; possible means it was inferred from a ?ver= string and should be verified.</p>
    {% endif %}
  </section>
  {% endif %}

  {# ============================= security ============================= #}
  <section class="page-break">
    <div class="section-head"><div><div class="eyebrow">Section 7</div><h2>Security</h2></div>
      <div class="caption">{{ security.headers_present }} of {{ security.headers_expected }} recommended headers set</div></div>

    {% if security.tls %}
    <div class="sec-group">
      <h3>Certificate and encryption</h3>
      <table><tbody>
        {% for r in security.tls %}
        <tr><td style="width:40%;">{{ r.label }}</td><td>{{ r.value }}</td>
          <td style="width:22%;">{% if r.status_word %}<span class="status-cell"><span class="icon {{ 'pass' if r.status == 'good' else 'fail' }}"></span>{{ r.status_word }}</span>{% endif %}</td></tr>
        {% endfor %}
      </tbody></table>
    </div>
    {% endif %}

    <div class="sec-group">
      <h3>Response headers</h3>
      {% if security.headers %}
      <table><thead><tr><th style="width:34%;">Header</th><th>Value</th><th style="width:16%;">Status</th></tr></thead><tbody>
        {% for r in security.headers %}
        <tr><td>{{ r.label }}</td><td class="secondary">{{ r.value }}</td>
          <td><span class="status-cell"><span class="icon pass"></span>{{ r.status_word }}</span></td></tr>
        {% endfor %}
      </tbody></table>
      {% else %}
      <p class="secondary">None of the recommended security headers were set. See the findings above.</p>
      {% endif %}
    </div>

    {% if security.cookies %}
    <div class="sec-group">
      <h3>Cookies</h3>
      <table><tbody>
        {% for r in security.cookies %}
        <tr><td style="width:40%;">{{ r.label }}</td><td>{{ r.value }}</td></tr>
        {% endfor %}
      </tbody></table>
    </div>
    {% endif %}
  </section>

  {# ============================= appendix ============================= #}
  <section class="appendix page-break">
    <div class="section-head"><div><div class="eyebrow">Section 8</div><h2>Appendix</h2></div>
      <div class="caption">{{ appendix | length }} measurements</div></div>

    <div class="methodology">
      <h3>How this was measured</h3>
      <ul>
        <li>Every figure was collected in a single automated pass and stored unmodified. Nothing here is an estimate.</li>
        <li>Field data (Core Web Vitals) is Google's Chrome UX Report: the 75th percentile of real visits over a rolling 28-day window.</li>
        <li>Everything else is measured directly against the live site: response headers, the TLS handshake, the redirect chain, and the HTML document.</li>
        {% if provenance.lighthouse_version %}<li>Lab figures come from Google Lighthouse on a throttled mobile profile. Each page's scores and metrics are the median of several runs; its audit list comes from the run with the median performance score.</li>{% endif %}
        {% if lh and lh.coverage %}<li>{{ lh.coverage }}{% if lh.cap_note %} {{ lh.cap_note }}{% endif %}</li>{% endif %}
        <li>Re-running produces a separate record; previous results are never overwritten, so before-and-after comparison is exact.</li>
      </ul>
      <h3>Run provenance</h3>
      <ul>
        <li>Audit reference {{ provenance.run_id }} (batch {{ provenance.batch_id }})</li>
        <li>SLAP {{ provenance.slap_version }}, observation schema v{{ provenance.schema_version }}</li>
        {% if provenance.lighthouse_version %}<li>Lighthouse {{ provenance.lighthouse_version }} on Chrome {{ provenance.chrome_version }}, throttling {{ provenance.throttling_profile }}</li>
        {% else %}<li>No lab audit was run; the figures here are network measurements only</li>{% endif %}
      </ul>
      {% if lh and lh.runtime %}
      <h3>Runtime settings</h3>
      <div class="runtime">
        <div><span>Emulated device</span><span>{{ lh.runtime.device }}{% if lh.runtime.viewport %} ({{ lh.runtime.viewport }}){% endif %}</span></div>
        <div><span>Network throttling</span><span>{{ lh.runtime.network }}</span></div>
        <div><span>CPU throttling</span><span>{{ lh.runtime.cpu }}</span></div>
        <div><span>Browser</span><span>{% if provenance.chrome_version %}Chrome {{ provenance.chrome_version }}{% else %}{{ lh.runtime.browser }}{% endif %}, headless</span></div>
        <div><span>Lighthouse</span><span>{{ provenance.lighthouse_version or lh.runtime.lighthouse_version }}</span></div>
        {% if lh.runtime.benchmark_index %}<div><span>CPU benchmark</span><span>{{ lh.runtime.benchmark_index | int }}{% if lh.benchmark_range %} (run range {{ lh.benchmark_range }}){% endif %}</span></div>{% endif %}
        <div><span>Session</span><span>Initial page load, single page</span></div>
        {% if lh.scope_label %}<div><span>Coverage</span><span>{{ lh.scope_label }}</span></div>{% endif %}
      </div>
      {% endif %}
    </div>

    {% if tech.cms or tech.cdn or tech.wp_rocket or tech.server %}
    <h3 style="margin:16px 0 6px;">Detected technology</h3>
    <div class="techlist">
      {% if tech.cms %}<span class="chip">Platform <strong>{{ tech.cms }}</strong></span>{% endif %}
      {% if tech.page_builder %}<span class="chip">Builder <strong>{{ tech.page_builder }}</strong></span>{% endif %}
      {% if tech.cdn %}<span class="chip">CDN <strong>{{ tech.cdn }}</strong></span>{% endif %}
      {% if tech.server %}<span class="chip">Server <strong>{{ tech.server }}</strong></span>{% endif %}
      {% if tech.cache_plugin %}<span class="chip">Caching <strong>{{ tech.cache_plugin }}</strong></span>{% endif %}
      {% if tech.wp_rocket %}<span class="chip">WP Rocket <strong>{{ tech.wp_rocket }}</strong></span>{% endif %}
    </div>
    {% endif %}

    <h3 style="margin:16px 0 6px;">All measurements</h3>
    <table>
      <thead><tr><th style="width:36%;">Measurement</th><th class="num" style="width:22%;">Value</th><th style="width:18%;">Source</th><th>Key</th></tr></thead>
      <tbody>
      {% for row in appendix %}
      <tr><td>{{ row.label }}</td><td class="num val">{{ row.value }}</td><td class="secondary">{{ row.source }}</td><td class="key">{{ row.metric_key }}</td></tr>
      {% endfor %}
      </tbody>
    </table>

    <div class="footer-note">Generated by SLAP {{ provenance.slap_version }} on {{ generated_at }}. Audit reference {{ run_id }}.{% if provenance.lighthouse_version %} Lab data by Lighthouse {{ provenance.lighthouse_version }}.{% endif %}</div>
  </section>

</div>
</body>
</html>
