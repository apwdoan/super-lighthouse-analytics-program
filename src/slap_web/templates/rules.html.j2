{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block title %}Rules &middot; SLAP{% endblock %}
{% block main %}
<div class="bar">
  <div>
    <h1>What SLAP checks for</h1>
    <div class="hint">
      {{ total }} rule{{ '' if total == 1 else 's' }}, applied to every audit.
      Each one is a sentence a client may read, so this is the page to
      review before sending a report rather than after.
    </div>
  </div>
</div>
<div class="content">

{% if error %}
  <div class="card notice">
    <span class="badge"><span class="sw poor"></span>Invalid</span>
    The rule file did not load: {{ error }}
  </div>
{% endif %}

{% for group in rules %}
  <div class="card">
    <header>
      <div class="grow">
        <h2>{{ group.word }}</h2>
        <div class="hint">
          {{ group.rules|length }} rule{{ '' if group.rules|length == 1 else 's' }}
        </div>
      </div>
      <span class="badge">
        <span class="sw {{ group.status }}"></span>{{ group.word }}
      </span>
    </header>
    <table>
      <thead><tr>
        <th style="width:22%">Rule</th><th>What it says</th>
        <th style="width:30%">What it recommends</th>
      </tr></thead>
      <tbody>
        {% for rule in group.rules %}
          <tr>
            <td>
              {{ rule.title }}
              <div class="hint" style="font-size:11px">{{ rule.id }}</div>
            </td>
            <td class="hint">{{ rule.detail }}</td>
            <td class="hint">
              {{ rule.remediation }}
              {% if rule.wp_rocket_setting %}
                <div style="margin-top:4px">
                  <b>In WP Rocket:</b> {{ rule.wp_rocket_setting }}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endfor %}

</div>
{% endblock %}
