{# A status colour NEVER travels alone. serious (#ec835a) and warning
   (#fab219) sit only ΔE 13.6 apart in normal vision and both are below 3:1
   contrast on this surface, so the word is what carries the meaning. There
   is deliberately no macro that renders a bare swatch. #}
{% macro badge(status, word) %}
<span class="badge"><span class="sw {{ status }}"></span>{{ word }}</span>
{%- endmacro %}

{% macro finding(f, fixed=False) %}
<div class="f{% if fixed %} fixed{% endif %}">
  {{ badge('muted' if fixed else f.status, 'Fixed' if fixed else f.word) }}
  <div class="body">
    <div class="t">{{ f.title }}</div>
    <div class="d">{{ f.detail }}</div>
    {% if f.wp_rocket_setting %}
      <div class="rocket"><b>In WP Rocket:</b> {{ f.wp_rocket_setting }}</div>
    {% endif %}
    {% if (f.effort and not fixed) or f.scope %}
      <div class="meta">
        {% if f.scope %}<span class="chip">{{ f.scope }}</span>{% endif %}
        {% if f.effort and not fixed %}<span class="chip">{{ f.effort|capitalize }} effort</span>{% endif %}
      </div>
    {% endif %}
  </div>
</div>
{%- endmacro %}
