{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block title %}Report &middot; {{ run.hostname }}{% endblock %}
{% block main %}
<div class="bar">
  <div>
    <div class="crumb"><a href="/site/{{ run.site_id }}">{{ run.hostname }}</a> / Run {{ run.id }}</div>
    <h1>Report preview</h1>
  </div>
  <div class="grow"></div>
  <span class="chip">
    {{ findings|length }} issue{{ '' if findings|length == 1 else 's' }} &middot;
    {{ pages|length }} page{{ '' if pages|length == 1 else 's' }} &middot;
    {{ observation_count }} observations
  </span>
  <button class="btn" onclick="document.getElementById('brand').hidden = !document.getElementById('brand').hidden">Branding</button>
  {# Downloads, not form posts: the deliverable of a click in a browser
     arrives through the browser. The `download` attribute keeps the
     navigation in place, so the page and its state survive the click. #}
  <a class="btn" href="/run/{{ run.id }}/download/html" download>Download HTML</a>
  {% if pdf_backend %}
    <a class="btn primary" href="/run/{{ run.id }}/download/pdf" download>Download PDF</a>
  {% else %}
    <button class="btn primary" disabled>Download PDF</button>
  {% endif %}
</div>
<div class="content">

  <div class="hint" style="text-align: right; margin-bottom: 10px">
    Downloads also archive a copy in {{ report_dir }}
  </div>

  {% if not pdf_backend %}
    <div class="card notice">
      <span class="badge"><span class="sw muted"></span>Unavailable</span>
      PDF export is off: {{ pdf_backend.detail }} The HTML is the artifact of
      record, so the report itself is unaffected.
    </div>
  {% endif %}

  <div id="brand" class="card" hidden>
    <header><div class="grow"><h2>Branding</h2></div></header>
    <form method="post" action="/branding" class="row">
      <input type="hidden" name="run_id" value="{{ run.id }}">
      <label>Company name
        <input name="company_name" value="{{ branding.get('company_name', '') }}"
               placeholder="Shown in the report header">
      </label>
      <label>Accent
        <input name="accent" value="{{ branding.get('accent', '') }}" placeholder="#2a78d6">
      </label>
      <button class="btn primary" type="submit">Apply</button>
    </form>
    <p class="hint">
      Applied to this session only. Persisting it means round-tripping your
      config.toml without eating the comments in it, which tomllib cannot do
      (it is read-only) and which is worth deciding deliberately.
    </p>
  </div>

  {% if pages|length > 1 %}
  <div class="card">
    <header>
      <div class="grow"><h2>Pages in this run</h2></div>
      <span class="chip">
        {{ measured }} of {{ pages|length }} measured
      </span>
    </header>
    <p class="hint" style="margin-top:0">
      One page per template gets the browser audit; the rest are checked for
      security and delivery. A page with no score was not measured, which is
      not the same as scoring zero.
    </p>
    <table class="grid">
      <thead>
        <tr><th>Page</th><th>Template</th><th>Role</th>
            <th class="num">Performance</th><th class="num">Issues</th></tr>
      </thead>
      <tbody>
        {% for p in pages %}
        <tr>
          <td class="mono">{{ p.path }}</td>
          <td>{{ p.template }}</td>
          <td class="secondary">{{ p.role }}</td>
          <td class="num">
            {# Never a bare colour, and never a blank cell. #}
            <span class="badge"><span class="sw {{ p.score_status }}"></span>{%
              if p.measured %}{{ p.score }} &middot; {{ p.score_word }}{%
              else %}{{ p.score_word }}{% endif %}</span>
          </td>
          <td class="num">{{ p.findings }}{% if p.urgent %}
            <span class="secondary">({{ p.urgent }} urgent)</span>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="card preview-frame">
    {# An iframe, not inlined. report.css declares its own :root tokens and
       targets a 190mm print page; sharing a document would have the two
       stylesheets fight, and a preview that is not byte-identical to the
       client's file is not a preview. #}
    <iframe src="/run/{{ run.id }}/report.html" title="Report preview" loading="lazy"></iframe>
  </div>
  <p class="hint" style="text-align:center">
    Exactly the HTML the client receives. The PDF is a rendering of this file,
    so what is above is what they get.
  </p>
</div>
{% endblock %}
