{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block title %}Findings &middot; SLAP{% endblock %}
{% block main %}
<div class="bar">
  <div>
    <h1>Findings across every site</h1>
    <div class="hint">
      {{ rules|length }} distinct rule{{ '' if rules|length == 1 else 's' }} open
      across {{ total_sites }} site{{ '' if total_sites == 1 else 's' }}
    </div>
  </div>
</div>
<div class="content">
{% if not rules %}
  <div class="card empty">
    <h2>Nothing open</h2>
    <p class="hint">Either every site is clean or nothing has been audited yet.</p>
  </div>
{% else %}
  <div class="card">
    <table>
      <thead><tr>
        <th>Finding</th><th>Severity</th><th class="num">Sites</th>
        <th style="width:170px">Share</th><th>Effort</th>
      </tr></thead>
      <tbody>
      {% for r in rules %}
        <tr>
          <td>
            <div class="host">{{ r.title }}</div>
            <div class="sub">{{ r.rule_id }}{% if r.wp_rocket_setting %}
              &middot; WP Rocket: {{ r.wp_rocket_setting }}{% endif %}</div>
          </td>
          <td>{{ m.badge(r.status, r.word) }}</td>
          <td class="num"><b>{{ r.site_count }}</b> <span class="sub">/ {{ total_sites }}</span></td>
          <td>
            {# A share bar, not a pie: one ratio against a limit is a meter. #}
            <div class="meter wide">
              <i style="width:{{ (r.share * 100)|round(1) }}%;background:var(--series-1)"></i>
            </div>
          </td>
          <td class="sub">{{ (r.effort or '--')|capitalize }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="hint">
    Grouped by rule id, not by title: titles carry per-site numbers
    ("Images could load 3.9s faster") and would split one rule into many rows.
    Only each site's most recent completed run counts, so a finding fixed six
    months ago is not still open.
  </p>
{% endif %}
</div>
{% endblock %}
