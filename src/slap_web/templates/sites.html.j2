{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block title %}Sites &middot; SLAP{% endblock %}
{% block main %}
<div class="bar">
  <div>
    <h1>Sites</h1>
    <div class="hint">
      {{ sites|length }} site{{ '' if sites|length == 1 else 's' }}
      {%- if clients %} &middot; {{ clients }} client{{ '' if clients == 1 else 's' }}{% endif %}
      {%- if audited_today %} &middot; {{ audited_today }} audited today{% endif %}
    </div>
  </div>
  <div class="grow"></div>
  <form method="post" action="/audit" class="inline">
    <input name="urls" placeholder="example.com, another.com" size="30">
    <label class="check"><input type="checkbox" name="lighthouse" value="1" checked> Lighthouse</label>
    <button class="btn primary" type="submit">Audit</button>
  </form>
</div>
<div class="content">
{% if not sites %}
  <div class="card empty">
    <h2>Nothing audited yet</h2>
    <p class="hint">Run an audit and the site appears here with its history.</p>
    <pre>slap audit example.com --lighthouse</pre>
  </div>
{% else %}
  <div class="card">
    <table>
      <thead><tr>
        <th>Site</th><th>Verdict</th><th class="num">Perf</th><th class="num">LCP</th>
        <th style="width:100px">Trend</th><th class="num">Open</th><th>Last audit</th>
      </tr></thead>
      <tbody>
      {% for s in sites %}
        <tr class="click" onclick="location='/site/{{ s.id }}'">
          <td>
            <div class="host">{{ s.hostname }}</div>
            {% if s.client %}<div class="sub">{{ s.client }}</div>{% endif %}
          </td>
          <td>{{ m.badge(s.score_status, s.score_word) }}</td>
          <td class="num">
            {{ s.score if s.score is not none else '--' }}
            {% if s.delta %}
              <div class="delta {{ 'up' if s.delta > 0 else 'down' }}">
                {{ '&#9650;'|safe if s.delta > 0 else '&#9660;'|safe }} {{ s.delta|abs }}
              </div>
            {% endif %}
          </td>
          <td class="num">{{ s.lcp }}</td>
          <td>
            {% if s.spark %}
              <svg width="88" height="22" viewBox="0 0 88 22" aria-hidden="true">
                <path d="{{ s.spark }}" fill="none" stroke="var(--de-emphasis)"
                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="{{ s.spark_last[0] }}" cy="{{ s.spark_last[1] }}" r="2.6"
                        fill="var(--series-1)"/>
              </svg>
            {% else %}<span class="sub">one run</span>{% endif %}
          </td>
          <td class="num">
            {{ s.open_count }}
            {% if s.urgent_count %}<div class="sub">{{ s.urgent_count }} urgent</div>{% endif %}
          </td>
          <td>{{ s.audited }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
</div>
{% endblock %}
