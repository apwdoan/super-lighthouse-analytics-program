{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block title %}{{ site.hostname }} &middot; SLAP{% endblock %}
{% block main %}
<div class="bar">
  <div>
    <div class="crumb"><a href="/">Sites</a>{% if site.client %} / {{ site.client }}{% endif %}</div>
    <h1>{{ site.hostname }}</h1>
  </div>
  <div class="grow"></div>
  <form method="post" action="/audit">
    <input type="hidden" name="site_id" value="{{ site.id }}">
    <input type="hidden" name="lighthouse" value="1">
    <button class="btn primary" type="submit">Audit now</button>
  </form>
</div>
<div class="content">

  <div class="card">
    <div class="hero">
      <div>
        <div class="hint">Performance, latest run</div>
        <div class="figure">{{ score if score is not none else '--' }}</div>
      </div>
      <div class="hero-side">
        {{ m.badge(score_status, score_word) }}
        {% if not trend.empty and trend.delta %}
          <div class="delta {{ 'up' if trend.delta > 0 else 'down' }}">
            {{ '&#9650;'|safe if trend.delta > 0 else '&#9660;'|safe }}
            {{ trend.delta|abs }} points across {{ trend.marks|length }} runs
          </div>
        {% endif %}
      </div>
      <div class="grow"></div>
      {% if latest %}
        <div class="right hint">
          Last audited {{ humanise(latest.started_at) }}<br>
          {% if latest.lh_version %}Lighthouse {{ latest.lh_version }}{% endif %}
          {% if latest.chrome_version %} &middot; Chrome {{ latest.chrome_version }}{% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="split">
    <div>
      <div class="card">
        <header>
          <div class="grow">
            <h2>Performance score over time</h2>
            <div class="hint">
              {% if trend.empty %}Not enough history yet
              {% else %}{{ trend.marks|length }} runs &middot; mobile{% endif %}
            </div>
          </div>
        </header>
        {% if trend.empty %}
          <p class="hint">
            A trend needs at least two completed runs. This site has
            {{ trend.count }}. Audit it again and the line appears.
          </p>
        {% else %}
        <div class="chartwrap">
          <svg viewBox="0 0 {{ trend.width }} {{ trend.height }}" width="100%"
               height="{{ trend.height }}" role="img"
               aria-label="Performance score across {{ trend.marks|length }} runs,
                           {{ trend.first.value }} to {{ trend.last.value }}.">
            {% for g in trend.gridlines %}
              <line x1="34" x2="{{ trend.width - 14 }}" y1="{{ g.y }}" y2="{{ g.y }}"
                    stroke="var(--grid)" stroke-width="1"/>
              <text class="ann" x="27" y="{{ g.y + 3.5 }}" text-anchor="end">{{ g.label }}</text>
            {% endfor %}
            <path d="{{ trend.area }}" fill="var(--series-1)" opacity=".08"/>
            <path d="{{ trend.line }}" fill="none" stroke="var(--series-1)"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            {% for mk in trend.marks %}
              <circle cx="{{ mk.x }}" cy="{{ mk.y }}" r="{{ 4.5 if mk.last else 3.2 }}"
                      fill="var(--series-1)" stroke="var(--surface)" stroke-width="2">
                <title>{{ mk.value }} on {{ mk.when }}</title>
              </circle>
            {% endfor %}
            {# First and last only. Never a number on every point. #}
            <text class="ann val" x="{{ trend.last.x }}" y="{{ trend.last.y - 11 }}"
                  text-anchor="end">{{ trend.last.value }}</text>
            <text class="ann" x="34" y="{{ trend.height - 8 }}">{{ trend.first.when }}</text>
            <text class="ann" x="{{ trend.width - 14 }}" y="{{ trend.height - 8 }}"
                  text-anchor="end">{{ trend.last.when }}</text>
          </svg>
        </div>
        {% endif %}
      </div>

      {% if not field_trend.empty %}
      <div class="card">
        <header>
          <div class="grow"><h2>Real visitors, {{ field_trend.weeks }} weeks</h2></div>
          {{ m.badge(field_trend.status, field_trend.status_word) }}
        </header>
        {# Separate from the run-derived chart above on purpose. One is what
           we measured on our machine, the other is what visitors actually
           experienced; a single line splicing them would be indefensible the
           first time the two disagreed. #}
        <svg viewBox="0 0 {{ field_trend.width }} {{ field_trend.height }}"
             width="100%" height="{{ field_trend.height }}" role="img"
             aria-label="Largest Contentful Paint over {{ field_trend.weeks }} weeks">
          <line x1="0" y1="{{ field_trend.threshold_y | round(1) }}"
                x2="{{ field_trend.width }}" y2="{{ field_trend.threshold_y | round(1) }}"
                stroke="var(--de-emphasis)" stroke-width="1" stroke-dasharray="4 4"/>
          <path d="{{ field_trend.path }}" fill="none" stroke="var(--series-1)"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="row between sub">
          <span>{{ field_trend.first_label }} &middot; {{ field_trend.first_value }}</span>
          <span>Good is {{ field_trend.threshold_text }} or less</span>
          <span>{{ field_trend.last_label }} &middot; {{ field_trend.last_value }}</span>
        </div>
        <p class="hint">
          Largest Contentful Paint for real visitors. Each point is a 28-day
          average and the points advance weekly, so they overlap: a change
          shows up spread over about four weeks rather than on the week it
          happened.
        </p>
      </div>
      {% endif %}

      <div class="card">
        <header>
          <div class="grow"><h2>Findings</h2></div>
          <div class="seg">
            <button aria-pressed="true" onclick="fTab(this,'open')">Open ({{ open_findings|length }})</button>
            <button aria-pressed="false" onclick="fTab(this,'fixed')">Fixed ({{ fixed_findings|length }})</button>
          </div>
        </header>
        <div id="f-open">
          {% if new_findings %}
            <p class="hint note">{{ new_findings|length }} of these are new since the previous run.</p>
          {% endif %}
          {% for f in open_findings %}{{ m.finding(f) }}{% else %}
            <p class="hint">Nothing fired. Either the site is clean or the rules need work.</p>
          {% endfor %}
        </div>
        <div id="f-fixed" hidden>
          {% for f in fixed_findings %}{{ m.finding(f, fixed=True) }}{% else %}
            <p class="hint">
              Nothing has been fixed between the last two runs. This compares rule
              ids, not titles, so a finding whose number merely improved still
              counts as open.
            </p>
          {% endfor %}
        </div>
      </div>
    </div>

    <div>
      <div class="card">
        <header><div class="grow"><h2>Core Web Vitals</h2></div></header>
        <div class="tiles">
          {% for t in tiles %}
          <div class="tile">
            <div class="lab">{{ t.label }}</div>
            <div class="val">{{ t.value }}</div>
            {{ m.badge(t.status, t.word) }}
            {% if t.source == 'lab' %}<span class="chip lab">lab</span>{% endif %}
            <div class="meter">
              <i style="width:{{ (t.fraction * 100)|round(1) }}%;background:var(--{{
                 'good' if t.status == 'good' else 'warning' if t.status == 'needs-improvement'
                 else 'serious' if t.status == 'poor' else 'muted-status' }})"></i>
              <b style="left:33.3%"></b><b style="left:66.6%"></b>
            </div>
            <div class="tick"><span>Good &le;{{ t.good_at }}</span><span>Poor &gt;{{ t.poor_above }}</span></div>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="card">
        <header><div class="grow"><h2>Runs</h2></div></header>
        <table>
          <tbody>
          {% for r in runs[:8] %}
            <tr class="click" onclick="location='/run/{{ r.id }}'">
              <td>
                <b>{{ humanise(r.started_at) }}</b>
                <div class="sub">{{ r.status }}{% if r.finding_count %} &middot; {{ r.finding_count }} findings{% endif %}</div>
              </td>
              <td class="num sub">run {{ r.id }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        <p class="hint" style="margin-top:10px">
          A report is a pure function of a run id, so every row here stays
          reproducible.
        </p>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function fTab(btn, which) {
  btn.parentNode.querySelectorAll("button")
     .forEach(b => b.setAttribute("aria-pressed", "false"));
  btn.setAttribute("aria-pressed", "true");
  document.getElementById("f-open").hidden  = which !== "open";
  document.getElementById("f-fixed").hidden = which !== "fixed";
}
</script>
{% endblock %}
