<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}SLAP{% endblock %}</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<div class="shell">
  <nav class="side">
    <div class="brand"><b>SLAP</b><span>0.2</span></div>
    <a class="nav" href="/" {% if nav in ('sites', 'site', 'run') %}aria-current="page"{% endif %}>
      <span class="ic">&#9638;</span>Sites
    </a>
    <a class="nav" href="/findings" {% if nav == 'findings' %}aria-current="page"{% endif %}>
      <span class="ic">&#9670;</span>Findings
    </a>
    <div class="side-foot">
      <div class="hint">Super Lighthouse Analytics Project</div>
      <button class="btn ghost" onclick="toggleTheme()">Toggle theme</button>
    </div>
  </nav>
  <div class="main">{% block main %}{% endblock %}</div>
</div>

{# The dock, on every page. Progress is a state, not a destination: a
   24-site batch with Lighthouse on is roughly 40 minutes and the operator
   must be able to keep working through it. #}
<div class="dock{{ ' live' if activity.running else '' }}" id="dock"
     {{ '' if activity.running or activity.total else 'hidden' }}>
  <div class="dock-bar" onclick="document.getElementById('dock').classList.toggle('open')">
    <span class="spinner" id="dock-spin"></span>
    <b id="dock-title">Auditing</b>
    <span class="hint" id="dock-counts"></span>
    <div class="track"><i id="dock-track" style="width:0%"></i></div>
    <div class="grow"></div>
    <button class="btn narrow" id="dock-refresh" hidden
            onclick="event.stopPropagation(); location.reload()">See results</button>
    <form method="post" action="/audit/cancel" onclick="event.stopPropagation()">
      <button class="btn ghost narrow" type="submit">Stop</button>
    </form>
    <span class="hint caret">&#9650;</span>
  </div>
  <div class="dock-body"><div id="dock-rows"></div></div>
</div>

<script>
/* One EventSource for the whole app. In the Qt front-end this was a
   thread-safe queue drained on a QTimer, and every threading bug in the
   project lived in that crossing. Here the UI is a different process, so
   there is nothing to marshal. */
(function () {
  const dock = document.getElementById("dock");
  if (!dock) return;
  const rows = document.getElementById("dock-rows");
  const source = new EventSource("/activity/stream");

  source.onmessage = (e) => {
    const a = JSON.parse(e.data);
    if (!a.total) { dock.hidden = true; return; }
    dock.hidden = false;
    dock.classList.toggle("live", a.running);
    document.getElementById("dock-title").textContent =
      a.running ? `Auditing ${a.total} site${a.total === 1 ? "" : "s"}` : "Batch finished";
    document.getElementById("dock-counts").textContent =
      `${a.done} of ${a.total} done`;
    document.getElementById("dock-track").style.width =
      `${a.total ? (a.done / a.total) * 100 : 0}%`;
    document.getElementById("dock-spin").hidden = !a.running;

    rows.innerHTML = a.sites.map(s => {
      const state = s.state === "done" ? '<span class="badge"><span class="sw good"></span>Done</span>'
        : s.state === "failed" ? '<span class="badge"><span class="sw critical"></span>Failed</span>'
        : s.state === "running" ? '<span class="spinner"></span>'
        : '<span class="badge"><span class="sw muted"></span>Queued</span>';
      const right = s.state === "done"
        ? `${s.observations} obs &middot; ${s.findings} findings`
        : (s.error || s.stage || "waiting for a worker");
      return `<div class="q">${state}<span class="grow">${s.url}</span>
              <span class="stage">${right}</span></div>`;
    }).join("");

    /* A finished batch leaves the page's own numbers stale, but reloading
       on its own yanks the page out from under whatever the operator is
       doing. It interrupted a navigation the first time it was tried. So
       it offers instead of seizing. */
    document.getElementById("dock-refresh").hidden = a.running || !a.total;
  };
})();
</script>
<script>
function toggleTheme() {
  const root = document.documentElement;
  root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
}
</script>
{% block scripts %}{% endblock %}
</body>
</html>
