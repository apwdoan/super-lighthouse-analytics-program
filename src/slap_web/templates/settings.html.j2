{% extends "base.html.j2" %}
{% block title %}Settings &middot; SLAP{% endblock %}
{% block main %}
<div class="bar">
  <div>
    <h1>Settings</h1>
    <div class="hint">Saved to {{ config_path }}</div>
  </div>
</div>
<div class="content">

  <div class="card">
    <header>
      <div class="grow">
        <h2>CrUX API key</h2>
        <div class="hint">
          Real-user Core Web Vitals from Google's Chrome UX Report. Without a
          key, reports rely on lab measurements only and say so. A key is
          free: <a href="https://developer.chrome.com/docs/crux/api"
                   target="_blank" rel="noopener">developer.chrome.com/docs/crux/api</a>
        </div>
      </div>
    </header>

    {% if key_error %}
      <div class="card notice">
        <span class="badge"><span class="sw poor"></span>Not saved</span>
        {{ key_error }}
      </div>
    {% endif %}

    {% if env_override %}
      <div class="card notice">
        <span class="badge"><span class="sw muted"></span>Note</span>
        The <code>CRUX_API_KEY</code> environment variable is set on this
        machine and takes precedence over the saved key whenever the app
        starts.
      </div>
    {% endif %}

    <form method="post" action="/settings/crux" class="row">
      <label>
        API key
        {# The stored key is never rendered, only its shape: loopback pages
           end up in screenshots and screen shares. An empty value with the
           mask as placeholder means submitting without typing cannot
           accidentally re-save or clear anything by surprise. #}
        <input name="key" size="46" autocomplete="off" spellcheck="false"
               placeholder="{{ crux_masked or 'AIza...' }}">
      </label>
      <button class="btn primary" type="submit">Save and test</button>
    </form>

    {% if crux_masked %}
      <div class="row" style="margin-top: 10px">
        <form method="post" action="/settings/crux/test">
          <button class="btn" type="submit">Test the stored key</button>
        </form>
        <form method="post" action="/settings/crux"
              onsubmit="return confirm('Remove the stored CrUX API key?')">
          <input type="hidden" name="key" value="">
          <button class="btn" type="submit">Clear</button>
        </form>
        <div class="hint">Stored key: {{ crux_masked }}</div>
      </div>
    {% else %}
      <div class="hint" style="margin-top: 10px">No key is stored.</div>
    {% endif %}

    {% if key_check %}
      <div class="card notice">
        {% if key_check[0] %}
          <span class="badge"><span class="sw good"></span>Working</span>
        {% else %}
          <span class="badge"><span class="sw poor"></span>Rejected</span>
        {% endif %}
        <span style="white-space: pre-line">{{ key_check[1] }}</span>
      </div>
    {% endif %}
  </div>

  <div class="card">
    <header>
      <div class="grow">
        <h2>Endpoint probing</h2>
        <div class="hint">
          Requests a short list of paths that should not be public
          (<code>.env</code>, <code>.git/config</code>, database dumps) and
          reports the ones that answer. It sends real requests to the
          client's server, so it needs two things switched on: this, and a
          recorded authorisation for each host.
        </div>
      </div>
      <span class="badge">
        <span class="sw {{ probe.status }}"></span>{{ probe.word }}
      </span>
    </header>

    {% if probe_error %}
      <div class="card notice">
        <span class="badge"><span class="sw poor"></span>Not saved</span>
        {{ probe_error }}
      </div>
    {% elif probe_note %}
      <div class="card notice">
        <span class="badge"><span class="sw good"></span>Saved</span>
        {{ probe_note }}
      </div>
    {% endif %}

    <p class="hint">{{ probe.text }}</p>

    <form method="post" action="/settings/probe" class="row">
      {% if probe.enabled %}
        <button class="btn" type="submit">Switch probing off</button>
      {% else %}
        <input type="hidden" name="enabled" value="1">
        <button class="btn" type="submit">Switch probing on</button>
      {% endif %}
    </form>

    <h3 style="margin: 18px 0 6px; font-size: 13px">Authorised hosts</h3>
    {% if probe_hosts %}
      <table>
        <thead><tr>
          <th>Host</th><th>Authorised</th><th>By</th><th>Reference</th><th></th>
        </tr></thead>
        <tbody>
          {% for host in probe_hosts %}
            <tr>
              <td>{{ host.hostname }}</td>
              <td class="hint">{{ humanise(host.probe_authorised_at) }}</td>
              <td class="hint">{{ host.probe_authorised_by or 'unknown' }}</td>
              <td class="hint">{{ host.probe_note or '' }}</td>
              <td>
                <form method="post" action="/settings/probe/revoke"
                      onsubmit="return confirm('Withdraw probing authorisation for {{ host.hostname }}?')">
                  <input type="hidden" name="hostname" value="{{ host.hostname }}">
                  <button class="btn narrow" type="submit">Revoke</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="hint">
        No host is authorised. Nothing will be probed until one is, whatever
        the switch above says.
      </p>
    {% endif %}

    <form method="post" action="/settings/probe/authorise" class="row"
          style="margin-top: 12px">
      <label>
        Host
        <input name="hostname" placeholder="example.com" size="22"
               autocomplete="off" spellcheck="false">
      </label>
      <label>
        Authorised by
        <input name="by" placeholder="who approved it" size="18"
               autocomplete="off">
      </label>
      <label>
        Reference
        <input name="note" placeholder="SOW, ticket, email" size="20"
               autocomplete="off">
      </label>
      <button class="btn" type="submit">Authorise</button>
    </form>
    <p class="hint">
      Recorded permanently against the site, and printed in that site's
      report. "Who said we could, and when" is the question this answers
      months later, so the name is required.
    </p>
  </div>

  <div class="card">
    <header>
      <div class="grow">
        <h2>Storage</h2>
        <div class="hint">Where this app keeps what it makes</div>
      </div>
    </header>
    <table>
      <tbody>
        <tr><td>Audit history</td><td class="hint">{{ db_path }}</td></tr>
        <tr><td>Exported reports</td><td class="hint">{{ report_dir }}</td></tr>
        <tr><td>Vulnerability database</td><td class="hint">{{ vulndb_path }}</td></tr>
        <tr><td>Configuration</td><td class="hint">{{ config_path }}</td></tr>
      </tbody>
    </table>
  </div>

  {% if not pdf_backend %}
    <div class="card notice">
      <span class="badge"><span class="sw muted"></span>PDF export unavailable</span>
      {{ pdf_backend.detail }}
    </div>
  {% endif %}

  <div class="card">
    <header>
      <div class="grow">
        <h2>Clear all history</h2>
        <div class="hint">
          {% if totals.runs %}
            This database holds {{ totals.sites }} site{{ '' if totals.sites == 1 else 's' }},
            {{ totals.runs }} run{{ '' if totals.runs == 1 else 's' }},
            {{ totals.findings }} finding{{ '' if totals.findings == 1 else 's' }} and
            {{ totals.observations }} observation{{ '' if totals.observations == 1 else 's' }},
            plus {{ totals.artifacts }} stored Lighthouse artifact{{ '' if totals.artifacts == 1 else 's' }}
            and {{ totals.crux_weeks }} week{{ '' if totals.crux_weeks == 1 else 's' }} of field-data history.
          {% else %}
            The database is empty. There is nothing to clear.
          {% endif %}
        </div>
      </div>
    </header>

    {% if clear_result %}
      <div class="card notice">
        <span class="badge"><span class="sw good"></span>Cleared</span>
        {{ clear_result }}
      </div>
    {% endif %}
    {% if clear_error %}
      <div class="card notice">
        <span class="badge"><span class="sw poor"></span>Not cleared</span>
        {{ clear_error }}
      </div>
    {% endif %}

    {% if totals.runs %}
      <p class="hint">
        Deletes every site, run, finding, observation, stored Lighthouse
        artifact and cached field-data week, permanently. There is no undo.
        Exported reports already on disk are not touched.
      </p>
      <form method="post" action="/settings/clear-history" class="row">
        <label>
          Type <b>delete</b> to confirm
          <input name="confirm" autocomplete="off" spellcheck="false"
                 placeholder="delete">
        </label>
        <button class="btn" type="submit"
                style="border-color: var(--serious); color: var(--serious)">
          Clear all findings and history
        </button>
      </form>
    {% endif %}
  </div>

</div>
{% endblock %}
